{
  "name": "pai",
  "version": "0.6.30",
  "private": true,
  "type": "module",
  "scripts": {
    "daemon": "bun run src/daemon.ts",
    "dev": "bun run scripts/dev.ts",
    "install": "bun run scripts/install.ts",
    "cli": "bun run src/clients/cli.ts",
    "infra": "bun run infra/apply.ts",
    "release": "bun run scripts/release.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p desktop/ui",
    "test": "bun run scripts/test.ts",
    "editor": "bun run scripts/editor.ts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true; node -e \"require('node-pty')\" 2>/dev/null || (cd node_modules/node-pty && npx --yes node-gyp rebuild >/dev/null 2>&1) || true",
    "desktop": "bun run scripts/desktop.ts",
    "desktop:build": "bun run scripts/desktop.ts --build",
    "build:ui": "bun -e 'const {buildUi} = await import(\"./scripts/desktop.ts\"); await buildUi(); console.log(\"built desktop/ui/dist\")'",
    "desktop:install": "bun run scripts/desktop.ts --install"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@elumixor/react-telegram": "^0.3.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "grammy": "^1.46.0",
    "ink": "7",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "telegram": "^2.26.22",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
