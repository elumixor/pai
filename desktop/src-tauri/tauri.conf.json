{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pai",
  "version": "0.1.0",
  "identifier": "dev.elumixor.pai.desktop",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "pai",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
