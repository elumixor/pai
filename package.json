{
  "name": "@desk/pai",
  "version": "0.7.15",
  "private": true,
  "type": "module",
  "scripts": {
    "daemon": "bun run src/daemon.ts",
    "dev": "devkit dev",
    "dev:box": "cd apps/web && bun run dev",
    "setup": "bun run src/clients/cli.ts dev install",
    "cli": "bun run src/clients/cli.ts",
    "release": "bun run src/clients/cli.ts dev release",
    "typecheck": "tsc --noEmit && cd apps/web && bun run check",
    "test": "bun run scripts/test.ts",
    "lint": "biome lint .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true; node -e \"require('node-pty')\" 2>/dev/null || (cd node_modules/node-pty && npx --yes node-gyp rebuild >/dev/null 2>&1) || true",
    "build:web": "cd apps/web && bun install --frozen-lockfile && bun run build",
    "test:web": "bun run build:web && bunx playwright test",
    "secrets:push": "devkit secrets push",
    "secrets:pull": "devkit secrets pull"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@anthropic-ai/sdk": "^0.137.0",
    "@clerk/backend": "^3.26.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@desk/connector": "github:elumixor/desk-connector#v0.1.0",
    "@elumixor/react-telegram": "^0.3.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "grammy": "^1.46.0",
    "ink": "7",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@elumixor/devkit": "^0.11.2",
    "@happy-dom/global-registrator": "^21.0.3",
    "@playwright/test": "^1.64.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "devkit": {
    "dev": {
      "web": {
        "processes": {
          "daemon": {
            "command": "bun test/web/server.ts",
            "port": 8898,
            "color": "blue"
          },
          "client": {
            "command": "PAI_DEV_API=http://127.0.0.1:8898 PAI_DEV_TOKEN=web-suite-token bun run --cwd apps/web dev",
            "port": 5180,
            "color": "magenta",
            "open": true
          }
        }
      }
    },
    "setup": {
      "secrets": [
        ".env",
        "pai.config.local.ts"
      ]
    }
  }
}
